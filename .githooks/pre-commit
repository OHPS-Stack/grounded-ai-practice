#!/bin/sh
# Grounded AI Practice — pre-commit guard
#
# Blocks three classes of mistake before they enter git history:
#   1. Anything under internal/ (never public)
#   2. Private markers leaking into tracked files
#   3. Legally-sensitive terms, and phrasing that has previously marked a
#      log entry written from a chat rather than from the project
#
# The marker list lives OUTSIDE tracked content, in
# internal/private_markers.txt — one case-insensitive substring per line,
# blank lines and lines starting with # ignored — so this public file
# never carries the strings it exists to block. A missing marker file
# refuses the commit: create it (even empty) so running without markers
# is a deliberate state, never a silent one.
#
# This is a guardrail against ACCIDENT, not a security control:
#   - it is local-only (not installed by cloning; see CLAUDE.md)
#   - it can be bypassed with `git commit --no-verify`
#   - it does nothing about anything already committed
# Treat it as the seatbelt, not the brakes.
#
# Install (run once per machine):
#   git config core.hooksPath .githooks

fail=0
markers_file="internal/private_markers.txt"

# --- 1. internal/ must never be staged -------------------------------
staged_internal=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^internal/' || true)
if [ -n "$staged_internal" ]; then
    echo "BLOCKED: files under internal/ are staged and must never be committed:"
    echo "$staged_internal" | sed 's/^/    /'
    echo ""
    fail=1
fi

# --- 2. private markers must not appear in staged content ------------
if [ ! -f "$markers_file" ]; then
    echo "BLOCKED: $markers_file is missing, so the marker check cannot run."
    echo "Create it — one private name/marker per line; an empty file is"
    echo "valid — so that running without markers is a deliberate choice."
    fail=1
else
    staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '^internal/' || true)
    for f in $staged_files; do
        [ -f "$f" ] || continue
        while IFS= read -r m || [ -n "$m" ]; do
            m=$(printf '%s' "$m" | tr -d '\r')
            case "$m" in ''|\#*) continue ;; esac
            if grep -Fiq "$m" "$f" 2>/dev/null; then
                echo "BLOCKED: a private marker (see $markers_file) appears in staged file: $f"
                fail=1
            fi
        done < "$markers_file"
    done
fi

# --- 3. personal circumstances and legally-sensitive terms ------------
#
# Added 2026-08-05 after a log entry written in an earlier session reached
# the staging area carrying the creator's forgotten disk passwords, their
# personal media stack, and a chat request that had been declined. See
# CLAUDE.md, "Tracked logs record the project, not the person".
#
# Scans ONLY ADDED LINES. Re-flagging existing content on every commit
# would bury the signal, and a noisy hook gets bypassed with --no-verify,
# which switches off checks 1 and 2 as well. Keeping this quiet is what
# keeps those two working.
#
# Two tiers, deliberately:
#
#   BLOCK   terms that should not appear in this repository's tracked
#           content at all. Narrow, so a hit is almost certainly real.
#
#   REVIEW  phrasing that has actually indicated the failure above.
#           Heuristic, so it prints loudly and does NOT block — a fuzzy
#           pattern that refuses the commit teaches you to reach for
#           --no-verify, and that costs more than it saves.
#
# What this cannot do: "the creator has forgotten three passwords" is a
# semantic problem, not a lexical one, and no pattern list catches the
# general case. The review gate in CLAUDE.md is the actual guard. This is
# the backstop for the specific wordings that have gone wrong once.
#
# .githooks/ is excluded from the scan because this file necessarily
# contains the words it searches for.
#
# Assumes GNU grep (\b word boundaries), which Git for Windows provides.

block_re='\b(iptv|piracy|pirated?|debrid|torbox|torrents?|warez)\b'
review_re='\b(forgot|forgotten|lost) (the |my |three )?passwords?\b|\bpasswords? (is|are|was|were) (not )?(remembered|forgotten|lost)\b|\bcreator (had )?(offered|asked me|wanted me|told me)\b|\bmy (house|home|flat|bedroom|landlord|neighbour)\b|\bwas declined\b'
generic_path='(yourname|youruser|username|user|someuser|example|test|name)'

review_hits=""
scan_files=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -vE '^(internal/|\.githooks/)' \
    | grep -viE '\.(png|jpe?g|gif|pdf|docx?|woff2?|ico|zip|ttf|svg)$' || true)

for f in $scan_files; do
    added=$(git diff --cached -U0 --diff-filter=ACM -- "$f" \
        | grep '^+' | grep -v '^+++' | sed 's/^+//' || true)
    [ -n "$added" ] || continue

    hit=$(printf '%s\n' "$added" | grep -inE "$block_re" || true)
    if [ -n "$hit" ]; then
        echo "BLOCKED: legally-sensitive term in lines added to: $f"
        printf '%s\n' "$hit" | sed 's/^/    /' | head -5
        echo ""
        fail=1
    fi

    hit=$(printf '%s\n' "$added" | grep -inE "$review_re" || true)
    [ -n "$hit" ] && review_hits="$review_hits
  $f
$(printf '%s\n' "$hit" | sed 's/^/    /' | head -3)"

    # Absolute user paths, minus the generic placeholders the guides use
    # deliberately (/home/yourname and friends).
    hit=$(printf '%s\n' "$added" \
        | grep -oiE '(c:\\+users\\+[a-z0-9._-]+|/home/[a-z0-9._-]+)' \
        | grep -viE "[\\\\/]$generic_path$" | sort -u || true)
    [ -n "$hit" ] && review_hits="$review_hits
  $f — machine-specific path
$(printf '%s\n' "$hit" | sed 's/^/    /' | head -3)"
done

if [ -n "$review_hits" ]; then
    echo "REVIEW: added lines match phrasing that has previously indicated"
    echo "personal detail reaching a tracked file. Not blocking — read them"
    echo "and decide. See CLAUDE.md, \"Tracked logs record the project, not"
    echo "the person\"."
    printf '%s\n' "$review_hits"
    echo ""
fi

if [ "$fail" -ne 0 ]; then
    echo "Commit refused by .githooks/pre-commit."
    echo "See CLAUDE.md, \"Public repo vs. internal working files\"."
    echo "If this is a genuine false positive, fix the content rather than"
    echo "using --no-verify."
    exit 1
fi

exit 0
