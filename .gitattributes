# Auto detect text files and perform LF normalization
* text=auto

# Pages generated by tools/build_site_pages.py are written with LF on every
# platform. Without this, autocrlf checks them out as CRLF on Windows, the
# builder rewrites them as LF, and git reports the file as modified when its
# content is identical.
docs/**/*.html text eol=lf

# GitHub Pages reads docs/CNAME literally. A stray CR makes the domain not
# match and the site falls back to the github.io URL, so pin it to LF.
docs/CNAME text eol=lf

# The guard hooks are sh scripts run by Git's own shell, which chokes on
# carriage returns. Pin them to LF so a Windows checkout can never rewrite
# them into a broken state.
.githooks/* text eol=lf

